{
  "name": "@personal-os/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Personal OS API, generated from the backend's OpenAPI schema.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --default-non-nullable false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "^7"
  }
}
