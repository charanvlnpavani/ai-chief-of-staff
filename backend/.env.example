# Copy to backend/.env for local development. Never commit the real .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Project-local PostgreSQL started with `pnpm db:setup` (port 55432, see scripts/dev-db.sh).
DATABASE_URL=postgresql+psycopg://localhost:55432/personal_os

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 32-byte AES keys as id:base64. Generate with:
#   python3 -c "import base64,os; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
# To rotate, put a new key first: ENCRYPTION_KEYS=k2:...,k1:...
ENCRYPTION_KEYS=

# The web app's origin (the Next.js dev server proxies /api to this backend).
WEB_ORIGIN=http://localhost:3000

# Only these emails may sign in (comma-separated). Put your Google account email here.
ALLOWED_LOGIN_EMAILS=owner@example.com
# Local-only "Continue as ..." button. Must be false in production.
DEV_LOGIN_ENABLED=true

# Google sign-in (optional locally). Create an OAuth client of type "Web application" with
# redirect URI http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# AI (Chief of Staff, roadmap drafts). Calls cost money; set a monthly budget in Settings.
# AI_KEY_MODE=user   -> each person adds their own Anthropic key in Settings (required in
#                       production; ANTHROPIC_API_KEY below is then ignored).
# AI_KEY_MODE=server -> single-user self-host: ANTHROPIC_API_KEY is used when you have not
#                       added a personal key.
AI_KEY_MODE=user
ANTHROPIC_API_KEY=
# Allow provider URLs on localhost / private networks (e.g. Ollama on this machine).
# Default: allowed in development, refused in production.
# AI_ALLOW_PRIVATE_ENDPOINTS=true
AI_MODEL_CHAT=claude-opus-5-5
AI_EFFORT_CHAT=medium
AI_DEFAULT_MONTHLY_BUDGET_USD=25

# Optional: "Learn more" for roadmap days from your own local clone of roadmap.sh content:
#   git clone --depth 1 https://github.com/nilbuild/developer-roadmap.git ~/code/developer-roadmap
# Its licence allows personal use only: the content is read from this machine and shown to
# you, never stored, committed, published or sent to an AI. Leave empty to show links only.
ROADMAP_SH_CONTENT_DIR=
